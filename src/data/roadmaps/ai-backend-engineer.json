{
  "id": "ai-backend-engineer",
  "title": "AI Backend Engineer",
  "description": "A dependency-aware path from engineering fundamentals to production AI backend systems.",
  "phases": [
    {
      "id": "engineering-mindset",
      "title": "Engineering Mindset",
      "description": "Develop the systems thinking and deliberate practice habits behind durable engineering growth.",
      "estimatedHours": 32,
      "dependencies": [],
      "learningObjectives": [{ "id": "first-principles", "title": "Practice first-principles reasoning", "completed": true }, { "id": "systems-thinking", "title": "Apply systems thinking to trade-offs", "completed": true }],
      "resources": [{ "id": "pragmatic-programmer", "title": "Read The Pragmatic Programmer", "completed": true }],
      "projects": [{ "id": "weekly-retrospective", "title": "Establish a weekly engineering retrospective", "completed": true }],
      "interviewQuestions": [{ "id": "tradeoff-example", "title": "Explain a technical trade-off you made", "completed": true }],
      "revisionTasks": [{ "id": "mindset-review", "title": "Review personal engineering principles", "completed": true }],
      "completionCriteria": ["Maintain a deliberate weekly retrospective for four weeks."]
    },
    {
      "id": "python",
      "title": "Programming — Python",
      "description": "Master Python fundamentals, typing, asynchronous programming, and testable design.",
      "estimatedHours": 120,
      "dependencies": ["engineering-mindset"],
      "learningObjectives": [{ "id": "python-typing", "title": "Use Python type hints confidently", "completed": true }, { "id": "python-async", "title": "Build asynchronous Python workflows", "completed": true }],
      "resources": [{ "id": "fluent-python", "title": "Study Fluent Python", "completed": true }],
      "projects": [{ "id": "async-scraper", "title": "Build an async web scraper", "completed": true }],
      "interviewQuestions": [{ "id": "asyncio-question", "title": "Explain asyncio concurrency boundaries", "completed": true }],
      "revisionTasks": [{ "id": "python-review", "title": "Review decorators, typing, and tests", "completed": false }],
      "completionCriteria": ["Ship a fully typed, tested asynchronous Python project."]
    },
    {
      "id": "problem-solving",
      "title": "Problem Solving",
      "description": "Build reusable algorithmic patterns and clear problem-solving communication.",
      "estimatedHours": 180,
      "dependencies": ["python"],
      "learningObjectives": [{ "id": "array-patterns", "title": "Master array and hashing patterns", "completed": true }, { "id": "graph-patterns", "title": "Solve graph traversal problems", "completed": false }],
      "resources": [{ "id": "neetcode-150", "title": "Work through NeetCode 150", "completed": false }],
      "projects": [{ "id": "solution-journal", "title": "Maintain a solution-pattern journal", "completed": true }],
      "interviewQuestions": [{ "id": "complexity-question", "title": "Justify time and space complexity", "completed": false }],
      "revisionTasks": [{ "id": "spaced-dsa", "title": "Re-solve missed problems without hints", "completed": false }],
      "completionCriteria": ["Solve 200 problems and explain core patterns without assistance."]
    },
    {
      "id": "backend-engineering",
      "title": "Backend Engineering",
      "description": "Build secure, observable APIs with storage, authentication, queues, and tests.",
      "estimatedHours": 220,
      "dependencies": ["python"],
      "learningObjectives": [{ "id": "api-design", "title": "Design RESTful APIs", "completed": true }, { "id": "auth-design", "title": "Implement JWT and OAuth flows", "completed": true }],
      "resources": [{ "id": "fastapi-docs", "title": "Study FastAPI documentation", "completed": true }],
      "projects": [{ "id": "multi-tenant-api", "title": "Ship a multi-tenant API", "completed": false }],
      "interviewQuestions": [{ "id": "api-versioning", "title": "Explain an API versioning strategy", "completed": false }],
      "revisionTasks": [{ "id": "backend-review", "title": "Review authentication and failure modes", "completed": false }],
      "completionCriteria": ["Ship two production-quality APIs with tests and observability."]
    },
    {
      "id": "software-engineering",
      "title": "Software Engineering",
      "description": "Design maintainable systems through clean architecture, testing, delivery, and review.",
      "estimatedHours": 140,
      "dependencies": ["python"],
      "learningObjectives": [{ "id": "clean-architecture", "title": "Apply clean architecture boundaries", "completed": true }, { "id": "ci-cd", "title": "Build a CI/CD pipeline", "completed": false }],
      "resources": [{ "id": "philosophy-software", "title": "Read A Philosophy of Software Design", "completed": true }],
      "projects": [{ "id": "legacy-refactor", "title": "Refactor a legacy codebase", "completed": false }],
      "interviewQuestions": [{ "id": "testing-strategy", "title": "Describe a pragmatic testing strategy", "completed": false }],
      "revisionTasks": [{ "id": "architecture-review", "title": "Review module boundaries in a project", "completed": false }],
      "completionCriteria": ["Deliver a reviewed project with CI, tests, and documented architecture."]
    },
    {
      "id": "cs-fundamentals",
      "title": "CS Fundamentals",
      "description": "Understand operating systems, networking, compilers, and concurrency at practical depth.",
      "estimatedHours": 160,
      "dependencies": ["problem-solving"],
      "learningObjectives": [{ "id": "os-basics", "title": "Explain processes, threads, and memory", "completed": false }, { "id": "networking-basics", "title": "Trace an HTTP request over TCP", "completed": false }],
      "resources": [{ "id": "ostep", "title": "Study OSTEP fundamentals", "completed": false }],
      "projects": [{ "id": "mini-http-server", "title": "Build a minimal HTTP server", "completed": false }],
      "interviewQuestions": [{ "id": "tcp-question", "title": "Explain TCP connection lifecycle", "completed": false }],
      "revisionTasks": [{ "id": "cs-flashcards", "title": "Review OS and network flashcards", "completed": false }],
      "completionCriteria": ["Implement and explain a concurrent network service."]
    },
    {
      "id": "databases",
      "title": "Databases",
      "description": "Model data correctly and reason about indexes, transactions, and query performance.",
      "estimatedHours": 130,
      "dependencies": ["backend-engineering"],
      "learningObjectives": [{ "id": "sql-modeling", "title": "Model relational data and constraints", "completed": true }, { "id": "query-planning", "title": "Interpret query plans and indexes", "completed": false }],
      "resources": [{ "id": "use-the-index", "title": "Study Use The Index, Luke!", "completed": false }],
      "projects": [{ "id": "postgres-optimization", "title": "Optimize a Postgres workload", "completed": false }],
      "interviewQuestions": [{ "id": "mvcc-question", "title": "Explain MVCC and transaction isolation", "completed": false }],
      "revisionTasks": [{ "id": "sql-drills", "title": "Revisit SQL and index drills", "completed": false }],
      "completionCriteria": ["Diagnose and improve a slow production-like database query."]
    },
    {
      "id": "distributed-systems",
      "title": "Distributed Systems",
      "description": "Reason about consistency, replication, queues, partitions, and failure recovery.",
      "estimatedHours": 200,
      "dependencies": ["backend-engineering", "cs-fundamentals", "databases"],
      "learningObjectives": [{ "id": "consistency", "title": "Explain consistency models and CAP", "completed": false }, { "id": "replication", "title": "Design replication and recovery flows", "completed": false }],
      "resources": [{ "id": "ddia", "title": "Study Designing Data-Intensive Applications", "completed": false }],
      "projects": [{ "id": "event-service", "title": "Ship an event-driven service", "completed": false }],
      "interviewQuestions": [{ "id": "raft-question", "title": "Explain Raft leader election", "completed": false }],
      "revisionTasks": [{ "id": "failure-analysis", "title": "Write distributed failure postmortems", "completed": false }],
      "completionCriteria": ["Design and defend a fault-tolerant event-driven system."]
    },
    {
      "id": "system-design",
      "title": "System Design",
      "description": "Turn distributed-systems knowledge into clear, scalable interview-ready designs.",
      "estimatedHours": 150,
      "dependencies": ["distributed-systems"],
      "learningObjectives": [{ "id": "capacity-planning", "title": "Estimate scale and capacity", "completed": false }, { "id": "design-tradeoffs", "title": "Communicate architecture trade-offs", "completed": false }],
      "resources": [{ "id": "system-design-interview", "title": "Study System Design Interview", "completed": false }],
      "projects": [{ "id": "design-doc-portfolio", "title": "Write five production design documents", "completed": false }],
      "interviewQuestions": [{ "id": "url-shortener", "title": "Design a globally scaled URL shortener", "completed": false }],
      "revisionTasks": [{ "id": "design-rehearsal", "title": "Rehearse designs under time pressure", "completed": false }],
      "completionCriteria": ["Complete five timed system-design simulations with written trade-offs."]
    },
    {
      "id": "ai-engineering",
      "title": "AI Engineering",
      "description": "Integrate model APIs into reliable, cost-aware production services.",
      "estimatedHours": 170,
      "dependencies": ["backend-engineering", "databases"],
      "learningObjectives": [{ "id": "inference-api", "title": "Build resilient inference API integrations", "completed": true }, { "id": "model-routing", "title": "Implement latency and cost-aware routing", "completed": true }],
      "resources": [{ "id": "openai-cookbook", "title": "Study production AI integration patterns", "completed": true }],
      "projects": [{ "id": "llm-gateway", "title": "Ship an LLM gateway", "completed": false }],
      "interviewQuestions": [{ "id": "ai-reliability", "title": "Design retries and fallbacks for model calls", "completed": false }],
      "revisionTasks": [{ "id": "ai-observability", "title": "Review AI service observability", "completed": false }],
      "completionCriteria": ["Ship an observable model service with defined latency and cost budgets."]
    },
    {
      "id": "llm-engineering",
      "title": "LLM Engineering",
      "description": "Build structured prompting, evaluations, guardrails, and fine-tuning workflows.",
      "estimatedHours": 150,
      "dependencies": ["ai-engineering"],
      "learningObjectives": [{ "id": "structured-output", "title": "Use reliable structured model outputs", "completed": true }, { "id": "eval-design", "title": "Design reproducible evaluations", "completed": false }],
      "resources": [{ "id": "llm-evals", "title": "Study LLM evaluation approaches", "completed": false }],
      "projects": [{ "id": "eval-harness", "title": "Build a prompt evaluation harness", "completed": false }],
      "interviewQuestions": [{ "id": "eval-question", "title": "Explain how you evaluate LLM quality", "completed": false }],
      "revisionTasks": [{ "id": "prompt-regression", "title": "Run a prompt regression review", "completed": false }],
      "completionCriteria": ["Maintain a repeatable evaluation suite with quality and cost signals."]
    },
    {
      "id": "ai-agents",
      "title": "AI Agents",
      "description": "Build scoped, reliable tool-using agents with planning, memory, and budgets.",
      "estimatedHours": 130,
      "dependencies": ["llm-engineering"],
      "learningObjectives": [{ "id": "agent-tools", "title": "Design safe tool interfaces", "completed": false }, { "id": "agent-memory", "title": "Evaluate memory and planning strategies", "completed": false }],
      "resources": [{ "id": "agent-survey", "title": "Study agent design patterns", "completed": false }],
      "projects": [{ "id": "research-agent", "title": "Build a scoped research agent", "completed": false }],
      "interviewQuestions": [{ "id": "agent-safety", "title": "Explain how to bound an agent's actions", "completed": false }],
      "revisionTasks": [{ "id": "agent-evals", "title": "Review agent failure cases", "completed": false }],
      "completionCriteria": ["Ship an agent that completes a bounded task within cost and latency limits."]
    },
    {
      "id": "cyber-security",
      "title": "Cyber Security",
      "description": "Design and operate web, API, cloud, and AI systems with secure defaults.",
      "estimatedHours": 110,
      "dependencies": ["backend-engineering"],
      "learningObjectives": [{ "id": "owasp", "title": "Recognize OWASP Top 10 risks", "completed": false }, { "id": "llm-security", "title": "Mitigate prompt injection and data exposure", "completed": false }],
      "resources": [{ "id": "portswigger", "title": "Complete PortSwigger Academy labs", "completed": false }],
      "projects": [{ "id": "security-review", "title": "Perform an API threat model", "completed": false }],
      "interviewQuestions": [{ "id": "ssrf-question", "title": "Explain SSRF mitigations", "completed": false }],
      "revisionTasks": [{ "id": "security-checklist", "title": "Review a secure delivery checklist", "completed": false }],
      "completionCriteria": ["Threat-model and remediate a realistic API or LLM application."]
    },
    {
      "id": "open-source",
      "title": "Open Source",
      "description": "Contribute effectively by reading unfamiliar systems, collaborating, and maintaining quality.",
      "estimatedHours": 80,
      "dependencies": ["software-engineering"],
      "learningObjectives": [{ "id": "codebase-reading", "title": "Navigate a large unfamiliar codebase", "completed": false }, { "id": "pr-collaboration", "title": "Create reviewable pull requests", "completed": false }],
      "resources": [{ "id": "first-contributions", "title": "Study contribution workflows", "completed": false }],
      "projects": [{ "id": "merged-pr", "title": "Land a meaningful external contribution", "completed": false }],
      "interviewQuestions": [{ "id": "oss-question", "title": "Describe an open-source collaboration challenge", "completed": false }],
      "revisionTasks": [{ "id": "pr-retrospective", "title": "Review feedback from merged pull requests", "completed": false }],
      "completionCriteria": ["Merge five high-quality contributions and document lessons learned."]
    },
    {
      "id": "career-preparation",
      "title": "Career Preparation",
      "description": "Package engineering evidence into a strong portfolio, interview process, and job search.",
      "estimatedHours": 90,
      "dependencies": ["system-design", "open-source"],
      "learningObjectives": [{ "id": "portfolio", "title": "Create evidence-led portfolio case studies", "completed": false }, { "id": "behavioral", "title": "Prepare concise STAR stories", "completed": false }],
      "resources": [{ "id": "interview-material", "title": "Study senior engineering interview material", "completed": false }],
      "projects": [{ "id": "personal-site", "title": "Ship a portfolio site with case studies", "completed": false }],
      "interviewQuestions": [{ "id": "leadership-question", "title": "Practice a leadership and conflict story", "completed": false }],
      "revisionTasks": [{ "id": "mock-loop", "title": "Complete a full mock interview loop", "completed": false }],
      "completionCriteria": ["Complete a portfolio, resume, and three full mock interview loops."]
    }
  ]
}
